# Used by `docker compose up`. Copy to .env to override the defaults:  cp .env.example .env
# Every value here is optional: the defaults let you run the demo with zero setup.

# Port the app is served on (http://localhost:8000)
APP_PORT=8000

# --- Change these before any real use ---------------------------------------
# Signs login tokens. Use a long random string:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Password of the PostgreSQL user (only reachable inside Docker)
POSTGRES_PASSWORD=change-me-too
# The admin login, created on first start
ADMIN_USER_ID=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrator

# --- Behaviour ---------------------------------------------------------------
# Monthly amount for a new customer when the admin does not enter one
DEFAULT_MONTHLY_AMOUNT=4500
# true = create 8 demo customers (with receipts) on the first start. Use false for real data.
SEED_DEMO=true
# Swagger UI at /docs and ReDoc at /redoc. Use false to hide them in production.
ENABLE_DOCS=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Month boundaries ("is this month's receipt in?") use this timezone
APP_TIMEZONE=Asia/Karachi
